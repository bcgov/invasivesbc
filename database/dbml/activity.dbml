Table "activity"."activity_basic" {
  "activity_id" uuid [pk, not null, note: 'rolling ID with Sequence', ref: < "activity"."batch"."activity_id", ref: < "activity"."aq_plant_mech_treatment"."activity_id", ref: < "activity"."aq_plant_mech_treatment_auth"."activity_id", ref: < "activity"."spread_results"."activity_id", ref: < "activity"."regional_details"."activity_id", ref: < "activity"."employer"."activity_id", ref: < "activity"."ter_plant_observation_detail"."activity_id", ref: < "activity"."aq_treatment_monitoring_information"."activity_id", ref: < "activity"."ter_treatment_monitoring_info"."activity_id", ref: < "activity"."weather_condition"."activity_id", ref: < "activity"."ter_plant_mech_treatment"."activity_id", ref: < "activity"."plant_phenology"."activity_id", ref: < "activity"."ter_plant_observation_type"."activity_id", ref: < "activity"."waterbody_data"."activity_id", ref: < "activity"."biocontrol_collection_information"."activity_id", ref: < "activity"."bio_treatment_release_information"."activity_id", ref: < "activity"."linked_record"."activity_id", ref: < "activity"."linked_record"."linked_record_id", ref: < "activity"."biocontrol_dispersal_monitoring_information"."activity_id", ref: < "activity"."aq_plant_observation_type"."activity_id", ref: < "activity"."chem_treatment"."activity_id", ref: < "activity"."microsite_condition"."activity_id", ref: < "activity"."activity_geometry"."activity_id", ref: < "activity"."ter_plant_observation_info"."activity_id", ref: < "activity"."platform"."activity_id", ref: < "activity"."pre_treatment_observation"."activity_id", ref: < "activity"."suitable_for_biocontrol"."activity_id"]
  "short_id" varchar(32) [not null, note: 'YY/SubtypeCode/first 8 digits of UUID']
  "activity_type" varchar(32) [not null]
  "activity_subtype" varchar(128) [not null]
  "activity_date" date [not null]
  "created_by" varchar(64) [not null]
  "form_status" form_status_enum [not null, default: `Draft`]
  "access_description" text
  "comment" text
  "created_timestamp" "timestamp with time zone" [not null]
  "received_timestamp" "timestamp with time zone" [not null]

  Indexes {
    short_id [name: "index_2"]
    activity_subtype [name: "index_3"]
    activity_date [name: "index_4"]
  }
}

Table "activity"."regional_details" {
  "activity_id" uuid [pk, not null]
  "biogeoclimatic_zone" varchar(64) [unique]
  "invasive_plant_management_areas" varchar(128)
  "ownership" varchar(64)
  "regional_districts" varchar(128)
  "flnro_districts" varchar(128) [note: 'Natural Resource Districts managed by the Ministry of Forests, Lands, Natural Resource Operations, and Rural Development (FLNRO) in British Columbia']
  "moti_districts" varchar(128) [note: 'Ministry of Transport and Infrastructure']
  "elevation" smallint [note: 'meters']
}

Table "activity"."project_code" {
  "activity_id" uuid [pk, not null, ref: < "activity"."activity_basic"."activity_id"]
  "description" varchar(64) [unique, not null]
  Note: '''optional field that can be added to a record to enable searching and sorting/ replaces IAPP\'s "Paper file ID"'''
}

Table "activity"."pre_treatment_observation" {
  "activity_id" uuid [pk, not null]
  "pre_treatment_observation" yes_no_unknown_enum
}

Table "activity"."agent_found_location" {
  "activity_id" uuid [pk, not null]
  "invasive_plant" varchar(500) [unique, not null]
  "agent" varchar(500) [unique, not null]
  "location_code" varchar(500) [unique, not null]
}

Table "activity"."linked_record" {
  "activity_id" uuid [pk, not null]
  "linked_record_id" bigint [unique, not null]
}

Table "activity"."waterbody_outflow_permanent" {
  "activity_id" uuid [pk, not null, ref: < "activity"."waterbody_data"."activity_id"]
  "outflow_code" varchar(32) [unique, not null]
}

Table "activity"."biocontrol_dispersal_monitoring_information" {
  "activity_id" uuid [not null, ref: < "activity"."biological_agent_count"."activity_id", ref: < "activity"."agent_found_location"."activity_id"]
  "invasive_plant" varchar(64) [ref: < "activity"."agent_found_location"."invasive_plant"]
  "biological_agent" varchar(64) [ref: < "activity"."biological_agent_count"."agent", ref: < "activity"."agent_found_location"."agent"]
  "biocontrol_present" boolean
  "sign_of_biocontrol_presence" varchar(32)
  "plant_count" smallint
  "count_duration_minutes" smallint
  "monitoring_method" varchar(32)
  "number_of_sweeps" smallint [note: 'when monitoring method is "Sweep"']
  "start_time" timestamptz
  "stop_time" timestamptz
  "linear_segment" yes_no_unknown
  "suitable_for_collection" yes_no_unknown

  Indexes {
    (activity_id, invasive_plant, biological_agent) [pk, name: "pk_table_29_id"]
  }
}

Table "activity"."aq_plant_observation_type" {
  "activity_id" uuid [pk, not null]
  "observation" observation_type_enum [not null]
  "plant_code" varchar(500) [unique]
}

Table "activity"."suitable_for_biocontrol" {
  "activity_id" uuid [pk, not null]
  "suitable_for_biocontrol" yes_no_unknown_enum [note: 'yes/no/unknown']
}

Table "activity"."plant_phenology" {
  "activity_id" uuid [pk, not null]
  "winter_dormant_pc" smallint [not null, default: 0]
  "seedlings_pc" smallint [not null, default: 0]
  "rosettes_pc" smallint [not null, default: 0]
  "bolts_pc" smallint [not null, default: 0]
  "flowering_pc" smallint [not null, default: 0]
  "seeds_forming_pc" smallint [not null, default: 0]
  "senescent_pc" smallint [not null, default: 0]
  "comment" text
}

Table "activity"."ter_voucher_specimen" {
  "activity_id" uuid [pk]
  "invasive_plant" varchar(64) [unique]
  "voucher_sample_id" bigint
  "date_collected" date
  "date_verified" date
  "herbarium" varchar(128)
  "accession_number" varchar(128)
  "completed_by_person" varchar(128) [default: 128]
  "completed_by_org" varchar(128)
  "utm_zone" smallint
  "utm_easting" integer
  "utm_northing" integer
}

Table "activity"."aq_plant_observation_detail" {
  "activity_id" uuid [pk, not null, ref: < "activity"."activity_basic"."activity_id", ref: < "activity"."ter_voucher_specimen"."activity_id", ref: < "activity"."aq_voucher_specimen"."activity_id"]
  "invasive_plant" varchar(64) [unique, ref: < "activity"."aq_voucher_specimen"."invasive_plant"]
  "density" varchar(64)
  "distribution" varchar(128)
  "life_stage" varchar(32)
  "sample_point_id" varchar(64) [note: 'For aquatic presence surveys']
}

Table "activity"."waterbody_inflow_seasonal" {
  "activity_id" uuid [pk, not null, ref: < "activity"."waterbody_data"."activity_id"]
  "inflow_code" varchar(32) [unique, not null]
}

Table "activity"."ter_plant_observation_type" {
  "activity_id" uuid [pk, not null]
  "observation" observation_type_enum [not null]
  "plant_code" varchar(500) [unique]
}

Table "activity"."waterbody_substrate_level" {
  "activity_id" uuid [pk, not null, ref: < "activity"."waterbody_data"."activity_id"]
  "substrate_code" varchar(32) [unique, not null]
}

Table "activity"."spread_results" {
  "activity_id" uuid [pk, not null]
  "agent_density_percent" smallint
  "plant_attack_percent" smallint
  "max_spread_distance" smallint
  "max_spread_aspect" smallint
}

Table "activity"."chem_treatment" {
  "activity_id" uuid [pk, not null]
  "service_license_number" varchar(128)
  "pesticide_use_permit" varchar(64)
  "pest_management_plan" varchar(128)
  "manual_pest_management_plan" varchar(128)
  "temperature_c" smallint
  "wind_speed_kmh" smallint
  "application_start_time" timestamptz
  "wind_direction" cardinal_direction
  "humidity" smallint
  "treatment_notice_signs" yes_no_unknown_enum [note: 'yes/no/unknown']
  "precautionary_statement" varchar(64)
  "ntz_reduction_bool" boolean
  "rationale_for_ntz_reduction" varchar(256)
  "additiona_unmapped_well_water_bool" boolean
  "pest_injury_threshold_determination_bool" boolean
}
