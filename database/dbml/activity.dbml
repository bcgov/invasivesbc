Table "activity"."activity_basic" {
  "activity_id" bigint [pk, not null, note: 'rolling ID with Sequence', increment, ref: < "activity"."batch"."activity_id", ref: < "activity"."spread_results"."activity_id", ref: < "activity"."regional_details"."activity_id", ref: < "activity"."employer"."activity_id", ref: < "activity"."treatment_monitoring_information"."activity_id", ref: < "activity"."weather_condition"."activity_id", ref: < "activity"."observation_type"."activity_id", ref: < "activity"."waterbody_data"."activity_id", ref: < "activity"."biocontrol_collection_information"."activity_id", ref: < "activity"."linked_record"."activity_id", ref: < "activity"."linked_record"."linked_record_id", ref: < "activity"."biocontrol_dispersal_monitoring_information"."activity_id", ref: < "activity"."chemical_treatment"."activity_id", ref: < "activity"."microsite_condition"."activity_id", ref: < "activity"."activity_geometry"."activity_id", ref: < "activity"."observation_plant_terrestrial_information"."activity_id", ref: < "activity"."platform"."activity_id", ref: < "activity"."pre_treatment_observation"."activity_id", ref: < "activity"."suitable_for_biocontrol"."activity_id", ref: < "activity"."mechanical_treatment"."activity_id", ref: < "activity"."aquatic_mechanical_plant_treatment_authorization"."activity_id", ref: < "activity"."bio_treatment_release_information"."activity_id", ref: < "activity"."plant_phenology"."activity_id"]
  "legacy_id" uuid [not null, default: `gen_random_id()`, note: 'legacy identifier for record (if applicable)']
  "created_by" varchar(64) [not null]
  "activity_type" varchar(32) [not null]
  "activity_subtype" varchar(128) [not null]
  "short_id" varchar(32) [not null, note: 'YY/SubtypeCode/first 8 digits of UUID']
  "activity_date" date [not null]
  "form_status" form_status [not null]
  "access_description" text
  "comment" text
  "created_timestamp" "timestamp with time zone" [not null]
  "received_timestamp" "timestamp with time zone" [not null]
  "is_active" boolean [note: 'If user deletes a record, set to inactive. Perserve records.']

  Indexes {
    short_id [name: "index_2"]
    activity_subtype [name: "index_3"]
    activity_date [name: "index_4"]
  }
}

