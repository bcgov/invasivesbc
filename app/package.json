    "@turf/turf": "^7.2.0",
    "@types/proj4": "^2.5.6",
    "dayjs": "^1.11.18",
    "esbuild": "^0.25.11",
    "immer": "^10.1.3",
    "is-number": "^7.0.0",
    "keycloak-js": "^26.2.0",
    "localforage": "^1.10.0",
